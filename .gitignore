# Dependency directories
node_modules/
jspm_packages/
web_modules/

# Debug logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Directory for instrumented libs generated by jscoverage/JSCover
lib-cov

# Coverage directory used by tools like istanbul
coverage
.nyc_output

# Grunt build folders
.grunt

# Bower dependency directory (if you use it)
bower_components

# node-waf configuration
.lock-wscript

# Compiled binary addons (https://nodejs.org)
build/Release

# Dependency directories for serverless framework
.serverless/

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Optional stylelint cache
.stylelintcache

# TypeScript cache and compiler output
*.tsbuildinfo
dist/
out/

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# Environment variables and local secrets (CRITICAL to avoid leaking API keys)
.env
.env.development.local
.env.test.local
.env.production.local
.env.local

# Operating System files
.DS_Store
Thumbs.db
